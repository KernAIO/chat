# Chat service. Kernel-level variables (DATABASE_URL, NATS_URL, VALKEY_URL, KERN_SECRET, CORE_URL…)
# are inherited from the umbrella .env in development.
PORT=4100
WS_HELLO_TIMEOUT_MS=10000
WS_PING_INTERVAL_MS=30000
PRESENCE_TTL_SEC=60
TYPING_THROTTLE_MS=2000
MAX_SOCKETS_PER_USER=12
# ceiling on how long a socket keeps a subscription a revocation event never reached it about
WS_REAUTH_INTERVAL_MS=60000
